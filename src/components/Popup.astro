---
import T from './T.astro';
import settings from '../data/settings.json';
const p = settings.popup;
const email = settings.contact.email;
---
<div class="pop" id="recruitPop" role="dialog" aria-modal="true" aria-labelledby="popTitle">
  <div class="box">
    <button type="button" class="x" data-pop-close aria-label="닫기 / Close">×</button>
    <h2 id="popTitle"><T v={p.title} /></h2>
    <p><T v={p.body} /></p>
    <ul>{p.points.map((x) => <li><span><T v={x} /></span></li>)}</ul>
    <p style="font-size:15px"><T v={p.closing} /></p>
    <p style="font-weight:700;color:var(--tx)"><T v={p.signature} /> · <a href={`mailto:${email}`} style="color:var(--ac);text-decoration:none">{email}</a></p>
    <div class="acts">
      <button type="button" class="a" data-pop-hide><T v={{ ko: '24시간 동안 보지 않기', en: 'Don’t show for 24 hours' }} /></button>
      <button type="button" class="b" data-pop-close><T v={{ ko: '닫기', en: 'Close' }} /></button>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var p = document.getElementById('recruitPop'); if (!p) return;
    var until = 0; try { until = +localStorage.getItem('sadi-pop-until') || 0; } catch (e) {}
    if (Date.now() > until) p.classList.add('show');
    function close() { p.classList.remove('show'); }
    p.addEventListener('click', function (e) {
      if (e.target === p || e.target.closest('[data-pop-close]')) close();
      if (e.target.closest('[data-pop-hide]')) { try { localStorage.setItem('sadi-pop-until', String(Date.now() + 864e5)); } catch (x) {} close(); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>
