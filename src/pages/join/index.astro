---
import Layout from '../../layouts/Layout.astro';
import T from '../../components/T.astro';
import Recruit from '../../components/Recruit.astro';
import data from '../../data/join.json';
import settings from '../../data/settings.json';
import { RV, pad2 } from '../../lib/util';
const email = settings.contact.email;
---
<Layout title="SADI Lab — Join us" active="join">
  <section class="subhero join-hero">
    <img src={data.image} alt="" class="bgimg kb" style="object-position:50% 40%;opacity:.4" />
    <div class="shade"></div>
    <div class="wrap" style="justify-content:center;padding-bottom:0">
      <h1 class="h2a join-h"><T v={data.headline} /></h1>
    </div>
  </section>
  <section class="sec nt">
    <div class="wrap stack" style="gap:40px">
      <h2 class="h2 m rv"><T v={{ ko: '함께 연구할 분께', en: 'For Prospective Researchers' }} /></h2>
      <div style="border-bottom:1px solid var(--ln)">
        {data.qualities.map((q, i) => <div class={`q ${RV[i % 4]}`}><span class="n">{pad2(i + 1)}</span><div style="display:flex;flex-direction:column;gap:12px"><b><T v={q.title} /></b><span><T v={q.text} /></span></div></div>)}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap stack" style="gap:40px">
      <div class="stack g22 rv">
        <h2 class="h2 m"><T v={{ ko: '연구 참여는 이메일로 문의해 주세요', en: 'Contact Us About Research Opportunities' }} /></h2>
        <p class="lead" style="font-size:17px"><T v={{ ko: `관심 분야와 간단한 소개를 ${email} 로 보내 주세요. 연구 참여 가능 여부와 면담 일정은 개별 안내합니다.`, en: `Please send a brief introduction and your research interests to ${email}. We will respond regarding available opportunities and possible meetings.` }} /></p>
      </div>
      <div class="two">{data.documents.map((d, i) => <div class={`doc ${RV[i % 4]}`}><span class="n">{pad2(i + 1)}</span><b><T v={d} /></b></div>)}</div>
    </div>
  </section>
  <Recruit details={false} />
</Layout>
