---
import '../styles/global.css';
import settings from '../data/settings.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup.astro';
import { hexToRgb } from '../lib/util';
import { on } from '../lib/nav';
import TrussMark from '../components/TrussMark.astro';
import T from '../components/T.astro';

const { title, description = 'SADI Lab — Structural Analysis, Design & Intelligence Laboratory, Pusan National University', active = '' } = Astro.props;
const th = settings.theme as any;
const vars = (t: any, dark: boolean) => `--bg:${t.bg};--s1:${t.surface};--s2:${t.surface2};--ln:${t.line};--ln2:${t.line2};--tx:${t.text};--t2:${t.text2};--t3:${t.text3};--ac:${t.accent};--a1:${t.area1};--a2:${t.area2};--a3:${t.area3};--bgrgb:${hexToRgb(t.bg)};--s1rgb:${hexToRgb(t.surface)};--shadow:${dark ? 'none' : '0 1px 2px rgba(22,19,15,.05), 0 10px 28px rgba(22,19,15,.06)'};`;
const f = settings.fonts;
const fontCss = `--f-disp:'${f.display}','${f.body}',sans-serif;--f-body:'${f.body}',sans-serif;--f-mono:'${f.mono}','${f.body}',monospace;`;
const themeCss = `:root{${fontCss}${vars(th.light, false)}}:root[data-theme="dark"]{${vars(th.dark, true)}}`;
const fam = [f.display, f.body, f.mono].filter((v, i, a) => v && a.indexOf(v) === i)
  .map((n) => `family=${n.trim().replace(/ /g, '+')}:wght@300;400;500;600;700;900`).join('&');
const fontsHref = `https://fonts.googleapis.com/css2?${fam}&display=swap`;
const def = th.default === 'dark' ? 'dark' : 'light';
const isPublic = (settings.show as any).public !== false;
const cs = (settings as any).comingSoon;
const pkey = String((settings as any).preview?.key ?? '');
---
<!doctype html>
<html lang="ko" data-lang="ko" data-theme={def}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!isPublic && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fontsHref} />
  <style is:inline set:html={themeCss}></style>
  {!isPublic && <script is:inline define:vars={{ pkey }}>
    try {
      var q = new URLSearchParams(location.search).get('preview');
      if (q === 'off') localStorage.removeItem('sadi-preview');
      else if (q && pkey && q === pkey) localStorage.setItem('sadi-preview', q);
      if (pkey && localStorage.getItem('sadi-preview') === pkey) document.documentElement.setAttribute('data-preview', '');
    } catch (e) {}
  </script>}
  <script is:inline define:vars={{ def }}>
    try {
      var r = document.documentElement;
      var l = localStorage.getItem('sadi-lang'); if (l === 'en' || l === 'ko') { r.dataset.lang = l; r.lang = l; }
      var t = localStorage.getItem('sadi-theme'); r.dataset.theme = (t === 'dark' || t === 'light') ? t : def;
    } catch (e) {}
  </script>
</head>
<body>
  {!isPublic && (
    <main class="soon" id="soonPage">
      <TrussMark size={88} />
      <b class="disp">{settings.lab.short} Lab</b>
      <h1><T v={cs?.title ?? { ko: '홈페이지 준비 중입니다', en: 'Coming soon' }} /></h1>
      <p><T v={cs?.body ?? { ko: '', en: '' }} /></p>
      <a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a>
      <div class="pill" role="group" aria-label="Language"><button type="button" data-set-lang="ko" aria-pressed="true">KO</button><button type="button" data-set-lang="en" aria-pressed="false">EN</button></div>
    </main>
  )}
  <div id={isPublic ? undefined : 'fullSite'}>
    {!isPublic && <div class="preview-bar">미리보기 모드 · 방문자에게는 '준비 중' 화면이 보입니다 <a href="?preview=off">미리보기 끝내기</a></div>}
    <a class="sr-only" href="#main">본문 바로가기</a>
    <Header active={active} />
    <main id="main"><slot /></main>
    <Footer />
    {on('popup') && active === 'home' && <Popup />}
  </div>
  <script is:inline>
    (function () {
      var r = document.documentElement;
      function sync() {
        document.querySelectorAll('[data-set-lang]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.setLang === r.dataset.lang)); });
        var dark = r.dataset.theme === 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          var ko = r.dataset.lang !== 'en';
          b.setAttribute('aria-label', dark ? (ko ? '밝은 테마로 전환' : 'Switch to light theme') : (ko ? '어두운 테마로 전환' : 'Switch to dark theme'));
          b.title = b.getAttribute('aria-label');
        });
      }
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-set-lang],[data-theme-toggle],[data-menu],[data-copy]');
        if (!el) return;
        if (el.dataset.setLang) { r.dataset.lang = el.dataset.setLang; r.lang = el.dataset.setLang; try { localStorage.setItem('sadi-lang', el.dataset.setLang); } catch (x) {} }
        if (el.hasAttribute('data-theme-toggle')) { var t = r.dataset.theme === 'dark' ? 'light' : 'dark'; r.dataset.theme = t; try { localStorage.setItem('sadi-theme', t); } catch (x) {} }
        if (el.hasAttribute('data-menu')) { var m = document.getElementById('navLinks'); var o = m.classList.toggle('open'); el.setAttribute('aria-expanded', String(o)); }
        if (el.dataset.copy) {
          try { navigator.clipboard && navigator.clipboard.writeText(el.dataset.copy).catch(function () {}); } catch (x) {}
          el.classList.add('done'); setTimeout(function () { el.classList.remove('done'); }, 2200);
        }
        sync();
      });
      sync();
    })();
  </script>
</body>
</html>
